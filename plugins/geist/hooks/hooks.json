{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/run.mjs\" codex SessionStart",
            "timeout": 5,
            "statusMessage": "Loading Geist session context",
            "additionalContextLimit": 2500,
            "commandWindows": "node \"$env:PLUGIN_ROOT/runtime/hooks/run.mjs\" codex SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/run.mjs\" codex UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Loading Geist prompt context",
            "additionalContextLimit": 2500,
            "commandWindows": "node \"$env:PLUGIN_ROOT/runtime/hooks/run.mjs\" codex UserPromptSubmit"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/run.mjs\" codex SubagentStart",
            "timeout": 5,
            "statusMessage": "Loading Geist subagent context",
            "additionalContextLimit": 2500,
            "commandWindows": "node \"$env:PLUGIN_ROOT/runtime/hooks/run.mjs\" codex SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/run.mjs\" codex SubagentStop",
            "timeout": 5,
            "commandWindows": "node \"$env:PLUGIN_ROOT/runtime/hooks/run.mjs\" codex SubagentStop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/run.mjs\" codex Stop",
            "timeout": 5,
            "commandWindows": "node \"$env:PLUGIN_ROOT/runtime/hooks/run.mjs\" codex Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/run.mjs\" codex SessionEnd",
            "timeout": 3,
            "commandWindows": "node \"$env:PLUGIN_ROOT/runtime/hooks/run.mjs\" codex SessionEnd"
          }
        ]
      }
    ]
  }
}
