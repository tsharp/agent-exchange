{
  "name": "geist",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build-hooks.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node scripts/validate-hooks.mjs",
    "test": "npm run typecheck && node scripts/build-hooks.mjs --check && npm run validate && node --test scripts/test-hooks.mjs scripts/test-installed-hooks.mjs scripts/test-rag.mjs scripts/test-mcp.mjs scripts/test-rag-hooks.mjs",
    "test:onnx": "node --test scripts/test-onnx.mjs",
    "test:codex": "node --test scripts/test-codex-mcp.mjs"
  },
  "devDependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.12",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "dependencies": {
    "onnxruntime-node": "1.21.1"
  }
}
